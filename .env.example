# DNS A record for this hostname must point to the Japan Ubuntu server.
DOMAIN=api.example.com
OPENROUTER_BASE_URL=https://openrouter.ai

# Default: loopback-only behind Caddy. Set to 0.0.0.0 for direct HTTP (unencrypted).
# HTTPS is recommended; if using HTTP, restrict the cloud firewall source IP.
GATEWAY_BIND_ADDRESS=127.0.0.1

# Server-side OpenRouter credential. Never put this in Claude Code, Codex, or Git.
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Client credentials accepted by this gateway (comma/newline-separated).
# Leave blank, then run ./scripts/create-client-key.sh to generate and append one.
# Put these client keys in CC Switch / Codex, never the OpenRouter key above.
CLIENT_API_KEYS=

# Optional OpenRouter attribution headers.
# App attribution supports OpenRouter app analytics; it does not split request logs by API key.
# Defaults below use the official Claude Code/Codex app URLs; new attribution is sent as hidden.
OPENROUTER_HTTP_REFERER=https://api.example.com
OPENROUTER_APP_TITLE=Personal OpenRouter Gateway
OPENROUTER_CLAUDE_HTTP_REFERER=https://claude.ai/code
OPENROUTER_CLAUDE_APP_TITLE=Claude Code
OPENROUTER_CODEX_HTTP_REFERER=https://codex.openai.com
OPENROUTER_CODEX_APP_TITLE=CodeX

# Per-client-key requests per rolling minute. Set 0 to disable.
RATE_LIMIT_PER_MINUTE=120

# Maximum request payload; streams are relayed without buffering the full body.
MAX_BODY_BYTES=20971520

# Upstream socket idle timeout. SSE streams remain open while data keeps flowing.
UPSTREAM_TIMEOUT_MS=600000
